{
  "name": "forgegate-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/forgegate-desktop/src",
  "tags": ["scope:desktop"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/forgegate-desktop",
        "browser": "apps/forgegate-desktop/src/main.ts",
        "tsConfig": "apps/forgegate-desktop/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/forgegate-desktop/public"
          }
        ],
        "styles": ["apps/forgegate-desktop/src/styles.css"],
        "allowedCommonJsDependencies": ["ajv", "ajv-formats"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "forgegate-desktop:build:production"
        },
        "development": {
          "buildTarget": "forgegate-desktop:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "cargo-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test",
        "cwd": "apps/forgegate-desktop/src-tauri"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/src/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock"
      ],
      "outputs": []
    },
    "cargo-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check",
        "cwd": "apps/forgegate-desktop/src-tauri"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/src/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock"
      ],
      "outputs": []
    },
    "e2e": {
      "dependsOn": []
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "forgegate-desktop:build",
        "staticFilePath": "dist/apps/forgegate-desktop/browser",
        "spa": true
      }
    }
  }
}
