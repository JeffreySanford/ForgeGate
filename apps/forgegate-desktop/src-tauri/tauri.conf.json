{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ForgeGate",
  "version": "0.1.0",
  "identifier": "com.truenorth.forgegate",
  "build": {
    "frontendDist": "../../../dist/apps/forgegate-desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm nx run forgegate-desktop:serve",
    "beforeBuildCommand": "pnpm nx run forgegate-desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "ForgeGate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
